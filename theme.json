{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"_comment": "PLACEHOLDER VISUAL IDENTITY — not yet signed off by Samantha (see README.md, Section 3 of the build brief). Colors, fonts, and spacing below are a starting direction only. Everything a designer would need to change to re-skin the site lives in this one file — swap values here, nothing else needs to change.",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "740px",
			"wideSize": "1120px"
		},
		"color": {
			"palette": [
				{ "slug": "charcoal", "color": "#1F2328", "name": "Charcoal (placeholder — primary dark)" },
				{ "slug": "steel", "color": "#4A5560", "name": "Steel (placeholder — secondary)" },
				{ "slug": "steel-light", "color": "#D8DCDF", "name": "Steel Light (placeholder — hairlines/borders)" },
				{ "slug": "off-white", "color": "#F4F3F1", "name": "Off-White (placeholder — background)" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "accent", "color": "#B5502F", "name": "Accent (placeholder — confirm with brand)" },
				{ "slug": "accent-dark", "color": "#8E3E24", "name": "Accent Dark (placeholder — hover/active)" }
			],
			"duotone": [],
			"gradients": [],
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"slug": "body",
					"name": "Body — plain sturdy sans-serif (placeholder, swap for licensed brand font once locked)"
				},
				{
					"fontFamily": "'Segoe UI', Arial, Helvetica, sans-serif",
					"slug": "heading",
					"name": "Heading — same family, heavier weight (placeholder)"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.125rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "2.25rem", "name": "X-Large" },
				{ "slug": "xx-large", "size": "3rem", "name": "XX-Large" }
			],
			"customFontSize": false,
			"lineHeight": true
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vh", "vw"],
			"customSpacingSize": true,
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "1" },
				{ "slug": "30", "size": "1rem", "name": "2" },
				{ "slug": "40", "size": "1.5rem", "name": "3" },
				{ "slug": "50", "size": "2.5rem", "name": "4" },
				{ "slug": "60", "size": "4rem", "name": "5" },
				{ "slug": "70", "size": "6rem", "name": "6" },
				{ "slug": "80", "size": "9rem", "name": "7" }
			],
			"blockGap": true
		},
		"border": {
			"radius": false,
			"color": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--off-white)",
			"text": "var(--wp--preset--color--charcoal)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--charcoal)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-dark)"
					}
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--white)",
					"background": "var(--wp--preset--color--accent)"
				},
				"border": {
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-dark)"
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "area": "header" },
		{ "name": "footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-services", "title": "Services", "postTypes": ["page"] },
		{ "name": "page-about", "title": "About", "postTypes": ["page"] },
		{ "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
	]
}
